# --- Database ---
# Local PostgreSQL development database:
DATABASE_URL="postgresql://maharminipos:CHANGE_ME@localhost:5432/maharminipos"

# --- Auth ---
# Generate with: openssl rand -hex 32
AUTH_SECRET=""

# --- Broker ---
# Lets the phone-shop app sign a grocery-shop user in, so one login at
# app.maharpos.shop lands the user in whichever app their account belongs to.
# Leave empty to keep broker login switched off.
# Generate with: openssl rand -hex 32
BROKER_SECRET=""

# --- App ---
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Mahar Mini POS"
DEFAULT_TIMEZONE="Asia/Yangon"
DEFAULT_CURRENCY="MMK"

# Each user connects a personal Telegram bot from the Telegram page.
# APP_URL must be the public HTTPS origin so Telegram can reach each webhook.

# --- Optional / future ---
REDIS_URL=""
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# --- Docker compose only ---
DB_PASSWORD=""
