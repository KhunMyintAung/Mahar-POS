# --- Database ---
# Local PostgreSQL development database:
DATABASE_URL="postgresql://maharminipos:CHANGE_ME@localhost:5432/maharminipos"

# --- Auth ---
# Generate with: openssl rand -hex 32
AUTH_SECRET=""

# --- Broker ---
# Lets the phone-shop app sign a grocery-shop user in, so one login at
# app.maharpos.shop lands the user in whichever app their account belongs to.
# Leave empty to keep broker login switched off.
# Generate with: openssl rand -hex 32
BROKER_SECRET=""

# --- App ---
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Mahar Mini POS"
DEFAULT_TIMEZONE="Asia/Yangon"
DEFAULT_CURRENCY="MMK"

# Each user connects a personal Telegram bot from the Telegram page.
# APP_URL must be the public HTTPS origin so Telegram can reach each webhook.

# --- Admin portal (/admin) ---
# Accounts (username or email, comma separated) that open the admin portal on sight.
ADMIN_USERS=""
# Optional shared passcode for the portal; leave empty to allow only ADMIN_USERS.
ADMIN_PASSCODE=""
# Where new sign-up alerts go; defaults to the emails in ADMIN_USERS.
ADMIN_NOTIFY_EMAIL=""

# --- Google sign-in ---
# Client id alone shows Google's own button; add the secret to use the redirect flow
# (redirect URI: <APP_URL>/api/v1/auth/google/callback).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email (Resend) ---
# Welcome, password reset, sign-up alerts and admin broadcasts. Empty = no email.
RESEND_API_KEY=""
RESEND_FROM=""
RESEND_REPLY_TO=""

# --- Optional / future ---
REDIS_URL=""
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# --- Docker compose only ---
DB_PASSWORD=""

# --- Mahar Shwe Point (MSP) ---
# The loyalty point on BNB Chain. Without MSP_CONTRACT and MSP_MINTER_KEY, shops can still
# switch points on; they are recorded and minted once the server is set up.
# Make the minter wallet on the server with: node scripts/msp-new-minter.mjs <env file>
# Only one server may mint with a given contract: the batch ids come from this database.
MSP_CONTRACT=""
MSP_MINTER_KEY=""
MSP_RPC="https://bsc-rpc.publicnode.com"
MSP_CHAIN_ID="56"
MSP_EXPLORER="https://bscscan.com"
