// Mahar Mini POS — database schema
// Money amounts are stored as BigInt in minor units (1/100 of the currency unit)
// to avoid floating-point errors. Rates/percentages are stored as decimal strings
// and computed with decimal.js in the service layer.
// PostgreSQL is used for development and production.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

// The same schema run inside a phone or computer for "This device only" shops (no server):
// a client with no native engine, used on PGlite (Postgres in the browser) by the device
// engine (src/device, built by scripts/build-device.mjs).
generator device {
  provider   = "prisma-client-js"
  output     = "../src/generated/device-prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  address   String?
  telegram  String?
  website   String?
  /// The words on the website button of the repair QR page; "Online Shop" when empty.
  websiteLabel String?
  city      String?
  /// Where the shop is, from the settings page's "use my location"; the QR page's map button opens it.
  latitude  Float?
  longitude Float?
  logoUrl   String?
  /// The shop's Online Shop address: app.maharpos.shop/shop/<shopSlug>. Empty = no shop yet.
  shopSlug  String?  @unique
  currency  String   @default("MMK")
  timezone  String   @default("Asia/Yangon")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches Branch[]
  users    User[]
  roles    Role[]
  settings SystemSetting[]
}

model Branch {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  name       String
  code       String
  address    String?
  phone      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userBranches UserBranch[]

  @@unique([businessId, code])
}

model Role {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  name        String
  description String?
  // JSON array of permission keys, e.g. ["three_d.view","wallet.transfer"]
  permissions String
  isSystem    Boolean  @default(false)
  users       User[]

  @@unique([businessId, name])
}

model User {
  id             String    @id @default(uuid())
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id])
  name           String
  username       String    @unique
  email          String?   @unique
  /// When the address was shown to be this person's: signed up or in with Google, or a
  /// password reset sent to it. Null means someone typed it in and nobody has proven it.
  emailVerifiedAt DateTime?
  phone          String?
  passwordHash   String
  roleId         String
  role           Role      @relation(fields: [roleId], references: [id])
  allBranches    Boolean   @default(false)
  active         Boolean   @default(true)
  // 3D commission rate as decimal string percent, e.g. "10" = 10%
  commissionRate String    @default("0")
  /// A technician's pay for each repair they finish: PERCENT of what the repair made (the
  /// charge less its parts), AMOUNT a fixed sum per repair, or NONE.
  repairCommissionMode    String @default("NONE")
  /// The percent, as a decimal string ("10" = 10%), when the mode is PERCENT.
  repairCommissionPercent String @default("0")
  /// The sum per repair, in minor units, when the mode is AMOUNT.
  repairCommissionAmount  BigInt @default(0)
  failedLogins   Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  telegramBotToken      String? @unique
  telegramBotUsername   String?
  telegramWebhookSecret String? @unique
  telegramChatId        String?

  branches      UserBranch[]
  sessions      AuthSession[]
  auditLogs     AuditLog[]
  notifications Notification[]
}

/// A user's own OpenAI, Gemini or DeepSeek key, for asking their bot about the shop. Encrypted with
/// AUTH_SECRET (lib/aiKey.ts); the plain key is never stored or shown again.
model TelegramAiKey {
  userId       String   @id
  /// OPENAI, GEMINI or DEEPSEEK
  provider     String
  encryptedKey String
  /// The key's last four characters, so the bot can say which key is in use.
  keyHint      String
  /// When the user was told their questions are kept. Questions are saved only after it:
  /// keys saved before the notice existed get it once, on their next question.
  questionsNoticeAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// A question asked of the Telegram AI helper, kept so the admin can see what shops want
/// to know. The answer is not kept: it holds the shop's own figures.
model AiQuestion {
  id         String   @id @default(uuid())
  userId     String
  businessId String
  question   String
  /// profit, sales, stock, debt, repair, expense, advice or other (lib/aiQuestions.ts)
  topic      String
  provider   String
  answered   Boolean
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model TelegramSession {
  ownerUserId String
  chatId      String
  step        String
  data        String   @default("{}")
  updatedAt   DateTime @updatedAt

  @@id([ownerUserId, chatId])
}

/**
 * A device left in for repair.
 * The shop's promise to a customer: what was handed over, what is wrong with it, what it
 * will cost and when it will be ready. Money only moves when the phone goes back out, so
 * a deposit and the final charge are held here until then.
 */
model RepairJob {
  id         String @id @default(uuid())
  jobNo      String
  businessId String
  branchId   String

  customerId    String?
  customerName  String?
  customerPhone String?

  deviceBrand String
  deviceModel String
  /**
   * Serial or IMEI, as read off the device.
   */
  imei        String?
  /**
   * What came in with it — case, SIM, memory card — so a dispute has an answer.
   */
  accessories String?
  problem     String
  /**
   * The state it arrived in — cracked screen, water mark — recorded before anyone opens it.
   */
  intakeCondition String?
  priority        String  @default("NORMAL") // LOW NORMAL HIGH URGENT

  status        String @default("RECEIVED") // RECEIVED CHECKING IN_PROGRESS WAITING_PARTS DONE CANNOT_REPAIR DELIVERED CANCELLED
  /**
   * Quoted up front; the final charge may differ once it is opened up.
   */
  estimatedCost BigInt @default(0)
  partsCost     BigInt @default(0)
  finalCost     BigInt @default(0)
  /**
   * Taken at drop-off and set against the final charge.
   */
  depositAmount BigInt @default(0)
  paidAmount    BigInt @default(0)

  technicianId String?
  /**
   * Who repairs it, by name: a technician need not have a login. Technician performance
   * (Repairs → Technicians) is counted by this name.
   */
  technicianName String?
  notes        String?

  receivedAt  DateTime  @default(now())
  promisedAt  DateTime?
  completedAt DateTime?
  deliveredAt DateTime?

  /// The shop's own trade-in phone (ItemSerial) being made ready to sell: no customer, no
  /// charge; its parts and repair fee go into the phone's cost.
  serialId    String?
  /// The repair fee for a shop phone, added to the phone's cost.
  laborCost   BigInt    @default(0)

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([businessId, jobNo])
  @@index([businessId, status])
  @@index([businessId, receivedAt])
  @@index([businessId, imei])
  @@index([customerId])
}

/**
 * A top-up biller — the float a phone shop holds with an operator.
 * Deliberately not a wallet. A wallet holds the shop's own money and can be transferred,
 * withdrawn and reconciled against a drawer; a float is stock bought from an operator that
 * can only be sold on as air-time. Modelling it as a wallet made every transfer screen
 * offer to move kyat into Mytel, which is not a thing a shop can do.
 * The balance is allowed to go negative: an operator that lets the shop sell on credit
 * leaves the float below zero until it is settled, and the shop's own records show that.
 */
model Biller {
  id             String    @id @default(uuid())
  businessId     String
  branchId       String?
  name           String
  /**
   * TOPUP_CARD sells pin-code cards; ELOAD sends credit straight to a number.
   */
  type           String    @default("TOPUP_CARD")
  currency       String    @default("MMK")
  openingBalance BigInt    @default(0)
  currentBalance BigInt    @default(0)
  active         Boolean   @default(true)
  /// Commission the operator puts back into the balance on each sale, as a percent of the amount sold.
  sellPercent    Float     @default(0)
  /// The refill deal, as a percent: BONUS adds it to the balance (pay 100,000, get 106,000);
  /// DISCOUNT takes it off the cash (get 100,000, pay 94,000).
  refillPercent  Float     @default(0)
  refillMode     String    @default("DISCOUNT")
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  transactions BillerTxn[]

  @@unique([businessId, name])
  @@index([businessId, active])
}

/**
 * One movement of a float: buying more of it, selling some of it, or correcting it.
 * `faceAmount` is what the float moves by and `cashAmount` is what the drawer moves by.
 * They are separate because the two are rarely equal — an operator sells 100,000 of credit
 * for 98,000, and that 2,000 is the shop's whole margin on the trade. Recording only one
 * figure loses it.
 */
model BillerTxn {
  id            String   @id @default(uuid())
  txnNo         String
  businessId    String
  branchId      String?
  billerId      String
  /**
   * TOPUP buys float, SALE sells it on, ADJUST corrects it after a count.
   */
  kind          String
  faceAmount    BigInt   @default(0)
  cashAmount    BigInt   @default(0)
  /**
   * Worked out once, at the point of sale, so a report never has to re-derive the sign.
   */
  profit        BigInt   @default(0)
  /// On a sale, what the operator put back into the balance; the balance fell by the amount less this.
  commission    BigInt   @default(0)
  /**
   * The wallet the cash moved through; absent for an adjustment.
   */
  walletId      String?
  balanceAfter  BigInt   @default(0)
  customerPhone String?
  note          String?
  /// On a sale made by tapping top-up cards: how many of each, as JSON {"1000": 2, "5000": 1}.
  cards         String?
  createdById   String?
  createdAt     DateTime @default(now())
  /// A voided movement has had its float and cash put back; it stays listed, crossed out.
  voidedAt      DateTime?
  voidedById    String?
  voidReason    String?

  biller Biller @relation(fields: [billerId], references: [id], onDelete: Cascade)

  @@unique([businessId, txnNo])
  @@index([billerId, createdAt])
  @@index([businessId, createdAt])
}

model UserBranch {
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
}

model AuthSession {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
}

// Shared contact directory: customers, suppliers, agents, creditors, debtors
model Contact {
  id          String    @id @default(uuid())
  businessId  String
  branchId    String?
  name        String
  phone       String?
  telegram    String?
  address     String?
  type        String    @default("CUSTOMER") // CUSTOMER SUPPLIER AGENT CREDITOR DEBTOR OTHER
  currency    String    @default("MMK")
  creditLimit BigInt    @default(0)
  notes       String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  receivables Receivable[]
  payables    Payable[]

  @@index([businessId, type])
  @@index([businessId, name])
}

model Wallet {
  id             String    @id @default(uuid())
  businessId     String
  branchId       String?
  name           String
  code           String
  type           String    @default("CASH") // CASH BANK MOBILE AGENT CUSTOMER EXPENSE CLEARING CUSTOM
  currency       String    @default("MMK")
  openingBalance BigInt    @default(0)
  currentBalance BigInt    @default(0)
  minBalance     BigInt    @default(0)
  active         Boolean   @default(true)
  description    String?
  version        Int       @default(0) // optimistic locking
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  ledger WalletLedgerEntry[]

  @@unique([businessId, code])
}

model WalletLedgerEntry {
  id           String   @id @default(uuid())
  walletId     String
  wallet       Wallet   @relation(fields: [walletId], references: [id])
  businessId   String
  branchId     String?
  direction    String // DEBIT (money in) | CREDIT (money out)
  amount       BigInt // always positive, minor units of wallet currency
  balanceAfter BigInt
  refType      String // OPENING CASH_IN CASH_OUT TRANSFER_IN TRANSFER_OUT EXCHANGE_IN EXCHANGE_OUT THREE_D_SETTLE CREDIT_COLLECT PAYABLE_PAY INCOME EXPENSE ADJUSTMENT REVERSAL
  refId        String?
  description  String?
  createdById  String
  createdAt    DateTime @default(now())

  @@index([walletId, createdAt])
  @@index([refType, refId])
}

model WalletTransfer {
  id             String   @id @default(uuid())
  txnNo          String
  businessId     String
  branchId       String?
  sourceWalletId String
  destWalletId   String
  sourceAmount   BigInt
  destAmount     BigInt
  rate           String? // required when currencies differ
  fee            BigInt   @default(0)
  /// The Transfer Fee expense filed for the fee (transfers made before it was filed have none).
  feeExpenseId   String?  @unique
  reference      String?
  notes          String?
  status         String   @default("COMPLETED") // COMPLETED REVERSED
  createdById    String
  createdAt      DateTime @default(now())

  @@unique([businessId, txnNo])
}

model WalletReconciliation {
  id             String   @id @default(uuid())
  businessId     String
  walletId       String
  systemBalance  BigInt
  countedBalance BigInt
  difference     BigInt
  date           String // YYYY-MM-DD
  notes          String?
  reconciledById String
  createdAt      DateTime @default(now())
}

model Receivable {
  id              String    @id @default(uuid())
  txnNo           String
  businessId      String
  branchId        String
  customerId      String
  customer        Contact   @relation(fields: [customerId], references: [id])
  reference       String?
  originalAmount  BigInt
  paidAmount      BigInt    @default(0)
  remainingAmount BigInt
  currency        String    @default("MMK")
  creditDate      String // YYYY-MM-DD
  dueDate         String?
  agentId         String?
  status          String    @default("UNPAID") // UNPAID PARTIAL PAID OVERDUE WRITTEN_OFF CANCELLED
  notes           String?
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  payments ReceivablePayment[]

  @@unique([businessId, txnNo])
  @@index([businessId, status])
}

model ReceivablePayment {
  id           String     @id @default(uuid())
  receivableId String
  receivable   Receivable @relation(fields: [receivableId], references: [id])
  amount       BigInt
  walletId     String
  date         String
  notes        String?
  createdById  String
  createdAt    DateTime   @default(now())
}

model Payable {
  id              String    @id @default(uuid())
  txnNo           String
  businessId      String
  branchId        String
  supplierId      String
  supplier        Contact   @relation(fields: [supplierId], references: [id])
  reference       String?
  originalAmount  BigInt
  paidAmount      BigInt    @default(0)
  remainingAmount BigInt
  currency        String    @default("MMK")
  payableDate     String
  dueDate         String?
  category        String?
  status          String    @default("UNPAID")
  notes           String?
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  payments PayablePayment[]

  @@unique([businessId, txnNo])
  @@index([businessId, status])
}

model PayablePayment {
  id          String   @id @default(uuid())
  payableId   String
  payable     Payable  @relation(fields: [payableId], references: [id])
  amount      BigInt
  walletId    String
  date        String
  notes       String?
  createdById String
  createdAt   DateTime @default(now())
}

model Category {
  id         String  @id @default(uuid())
  businessId String
  type       String // INCOME | EXPENSE
  name       String
  active     Boolean @default(true)
  /// One of the standard daily categories (DAILY_SALE, DAILY_SERVICE, DAILY_BILL,
  /// DAILY_GENERAL): can be renamed, never deleted, and the dashboard groups by it.
  systemKey  String?

  @@unique([businessId, type, name])
  @@unique([businessId, type, systemKey])
}

model IncomeExpense {
  id           String    @id @default(uuid())
  txnNo        String
  businessId   String
  branchId     String
  type         String // INCOME | EXPENSE | WITHDRAW
  categoryId   String?
  categoryName String?
  amount       BigInt
  currency     String    @default("MMK")
  walletId     String
  date         String // YYYY-MM-DD
  reference    String?
  description  String?
  status       String    @default("COMPLETED") // COMPLETED REVERSED
  /// Set on the expense record of a biller float purchase: the purchase already took the
  /// money out of the wallet, so this entry moves no money of its own.
  billerTxnId  String?   @unique
  /// Set on the expense record of a purchase: the purchase itself paid the supplier, so
  /// this entry moves no money of its own either.
  purchaseId   String?   @unique
  /** Set on the expense of a payment to a supplier for a purchase on credit (and the purchase
   *  in fromPurchaseId): the payment moved the money; this records the cost on the day paid. */
  payablePaymentId String? @unique
  fromPurchaseId   String?
  /// The supplier an expense was paid to (a SUPPLIER contact), for the monthly total per supplier.
  supplierId   String?
  createdById  String
  approvedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@unique([businessId, txnNo])
  @@index([businessId, type, date])
  @@index([businessId, supplierId, date])
  @@index([fromPurchaseId])
}

model DailyClose {
  id            String    @id @default(uuid())
  businessId    String
  branchId      String
  date          String // YYYY-MM-DD
  status        String    @default("OPEN") // OPEN SUBMITTED APPROVED CLOSED REOPENED
  summary       String // JSON snapshot of all computed totals
  countedNotes  String?
  submittedById String?
  approvedById  String?
  closedAt      DateTime?
  reopenedById  String?
  reopenedAt    DateTime?
  reopenReason  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([branchId, date])
}

model AuditLog {
  id           String   @id @default(uuid())
  businessId   String
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  branchId     String?
  action       String // LOGIN LOGIN_FAILED CREATE UPDATE DELETE RESTORE APPROVE SETTLE REOPEN REVERSE ADJUST PERMISSION_CHANGE RATE_CHANGE DAILY_CLOSE
  module       String
  resourceType String?
  resourceId   String?
  before       String? // JSON
  after        String? // JSON
  ip           String?
  userAgent    String?
  reason       String?
  createdAt    DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([resourceType, resourceId])
}

model SystemSetting {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  key        String
  value      String // JSON
  updatedAt  DateTime @updatedAt

  @@unique([businessId, key])
}

model NumberSequence {
  id         String @id @default(uuid())
  businessId String
  key        String // THREE_D EXCHANGE TRANSFER CREDIT PAYABLE INCOME EXPENSE CLOSE
  prefix     String
  next       Int    @default(1)

  @@unique([businessId, key])
}

model Notification {
  id         String    @id @default(uuid())
  businessId String
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  type       String
  title      String
  body       String?
  link       String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, readAt])
}

// ===== POS & Inventory (merged from ERP POS SYSTEM) =====

model ItemCategory {
  id         String  @id @default(uuid())
  businessId String
  name       String
  parentId   String? // set for sub-categories
  active     Boolean @default(true)

  items Item[]

  @@unique([businessId, name, parentId])
}

model Unit {
  id         String  @id @default(uuid())
  businessId String
  name       String // pcs, kg, box…
  active     Boolean @default(true)

  items Item[]

  @@unique([businessId, name])
}

model Item {
  id           String        @id @default(uuid())
  businessId   String
  name         String
  sku          String
  barcode      String?
  categoryId   String?
  category     ItemCategory? @relation(fields: [categoryId], references: [id])
  unitId       String?
  unit         Unit?         @relation(fields: [unitId], references: [id])
  costPrice    BigInt        @default(0) // minor units
  sellingPrice BigInt        @default(0)
  currency     String        @default("MMK")
  minStock     Int           @default(0)
  active       Boolean       @default(true)
  /// Each unit has its own IMEI or serial, recorded when it comes in and picked when sold.
  trackSerial  Boolean       @default(false)
  /// False: the quantity is unlimited. It can always be sold and no stock is counted (a service,
  /// a fee, anything the shop does not count).
  trackStock   Boolean       @default(true)
  description  String?
  /// Shown in the shop's Online Shop, with its photos.
  onlineVisible Boolean      @default(false)
  /// Variants, the light way: items with the same model ("iPhone 13") are shown together in
  /// Items, POS and the Online Shop, each with its own variant ("128GB · Blue"). Each variant
  /// is still an item of its own — its own price, stock, IMEIs and SKU.
  model        String?
  variant      String?
  /// Best before, for food, drinks and medicine (a mini mart); the day only.
  expiresAt    DateTime?     @db.Date
  /// A second-hand phone: how it looks and works ("Like new", "Small scratches"…).
  condition     String?
  /// A second-hand phone's battery health, 0–100 (%).
  batteryHealth Int?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  stockLevels   StockLevel[]
  serials       ItemSerial[]
  movements     StockMovement[]
  purchaseLines PurchaseLine[]
  transferLines StockTransferLine[]
  saleLines     SaleLine[]
  images        ItemImage[]

  @@unique([businessId, sku])
  @@index([businessId, name])
  @@index([businessId, model])
}

model StockLevel {
  id       String @id @default(uuid())
  itemId   String
  item     Item   @relation(fields: [itemId], references: [id])
  branchId String
  quantity Int    @default(0)

  @@unique([itemId, branchId])
}

model StockMovement {
  id          String   @id @default(uuid())
  businessId  String
  itemId      String
  item        Item     @relation(fields: [itemId], references: [id])
  branchId    String
  type        String // PURCHASE SALE ADJUSTMENT PURCHASE_RETURN SALE_RETURN TRANSFER_IN TRANSFER_OUT
  quantity    Int // signed: positive = stock in, negative = stock out
  qtyAfter    Int
  refType     String?
  refId       String?
  notes       String?
  createdById String
  createdAt   DateTime @default(now())

  @@index([itemId, branchId, createdAt])
  @@index([refType, refId])
}

model Purchase {
  id            String    @id @default(uuid())
  txnNo         String
  businessId    String
  branchId      String
  supplierId    String?
  subtotal      BigInt
  discount      BigInt    @default(0)
  total         BigInt
  paidAmount    BigInt    @default(0)
  paymentStatus String    @default("UNPAID") // UNPAID PARTIAL PAID
  status        String    @default("COMPLETED") // COMPLETED CANCELLED
  walletId      String?
  payableId     String?
  /** What it was bought for: SALE (goods to sell) or SERVICE (repair parts). */
  line          String?
  /// A second-hand phone bought from a person (trade-in): it waits in QC, and goes into sale
  /// stock only once checked (and repaired, if it needs it). See src/services/tradeInService.ts.
  tradeIn       Boolean   @default(false)
  date          String // YYYY-MM-DD
  reference     String?
  notes         String?
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  lines PurchaseLine[]

  @@unique([businessId, txnNo])
  @@index([businessId, branchId, date])
}

model PurchaseLine {
  id         String   @id @default(uuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id])
  quantity   Int
  unitCost   BigInt
  lineTotal  BigInt
}

model Sale {
  id            String    @id @default(uuid())
  txnNo         String
  businessId    String
  branchId      String
  customerId    String?
  subtotal      BigInt
  discount      BigInt    @default(0)
  total         BigInt
  paidAmount    BigInt    @default(0)
  paymentStatus String    @default("PAID") // PAID PARTIAL UNPAID
  status        String    @default("COMPLETED") // COMPLETED CANCELLED
  walletId      String?
  receivableId  String?
  /// Goods fetched from another shop for this sale and not paid for yet: what is owed them.
  outsidePayableId String?
  totalCost     BigInt    @default(0)
  profit        BigInt    @default(0) // total - discount... = revenue - cost
  date          String
  reference     String?
  notes         String?
  /// Set by the till for a sale rung up without the internet and sent later: the same
  /// sale sent twice (a resend after a lost reply) is recorded once.
  clientRef     String?
  /// When a sale rung up without the internet was actually made at the till.
  offlineAt     DateTime?
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  lines SaleLine[]

  @@unique([businessId, txnNo])
  @@unique([businessId, clientRef])
  @@index([businessId, branchId, date])
}

model SaleLine {
  id        String @id @default(uuid())
  saleId    String
  sale      Sale   @relation(fields: [saleId], references: [id])
  itemId    String
  item      Item   @relation(fields: [itemId], references: [id])
  quantity  Int
  unitPrice BigInt
  unitCost  BigInt
  lineTotal BigInt
  /**
   * The warranty given with this line, as printed on the receipt ("1 year"), and its length
   * in days so the end date can be worked out from the sale date. Empty when none was given.
   */
  warranty     String?
  warrantyDays Int     @default(0)
  /**
   * NEW or SECOND for a phone sold with a warranty, so its warranty card prints the right
   * terms even after the product's category changes.
   */
  warrantyCondition String?
  /**
   * Free text for this line, e.g. the IMEI or what the customer traded in.
   */
  note              String?
}

/// One unit of an IMEI-tracked item (a phone), from the day it comes in to the day it leaves.
model ItemSerial {
  id         String    @id @default(uuid())
  businessId String
  branchId   String
  itemId     String
  item       Item      @relation(fields: [itemId], references: [id])
  /// IMEI or serial number, spaces removed.
  imei       String
  /// IN_STOCK, SOLD or REMOVED (damaged, used, returned to supplier); a trade-in phone is
  /// QC (bought, not checked yet) or IN_REPAIR first, and not in the shelf count until then.
  status     String    @default("IN_STOCK")
  purchaseId String?
  /// What this one unit cost when bought (minor units); a sale of it counts this cost, not
  /// the item's average. Empty for units recorded without a purchase. For a trade-in phone it
  /// includes what its repair cost (repairCost).
  cost       BigInt?
  /// Trade-in: the repair that made it sellable — parts and repair fee, part of cost.
  repairCost    BigInt    @default(0)
  repairJobId   String?
  /// Trade-in QC: grade (A best to D), body condition, battery health (%) and what was found.
  qcGrade       String?
  bodyCondition String?
  batteryHealth Int?
  qcNote        String?
  qcAt          DateTime?
  saleId     String?
  saleLineId String?
  notes      String?
  receivedAt DateTime  @default(now())
  soldAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([businessId, imei])
  @@index([businessId, itemId, status])
  @@index([saleId])
  @@index([purchaseId])
}

/// Every email the app sends through Resend, for the admin portal's email log.
model EmailLog {
  id          String   @id @default(uuid())
  /// Resend's id, used to read the email's latest delivery event.
  resendId    String?  @unique
  to          String
  subject     String
  /// WELCOME RESET SIGNUP_ALERT BROADCAST TEST
  kind        String
  broadcastId String?
  /// SENT FAILED, then Resend's last event: delivered opened clicked bounced complained…
  status      String   @default("SENT")
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
  @@index([broadcastId])
  @@index([kind, createdAt])
}

/// A message the platform admin sent to many users at once.
model EmailBroadcast {
  id         String    @id @default(uuid())
  subject    String
  /// The text as written in the composer; the HTML is built from it when sent.
  body       String
  audience   String
  recipients Int       @default(0)
  sent       Int       @default(0)
  failed     Int       @default(0)
  /// QUEUED SENDING DONE
  status     String    @default("QUEUED")
  createdBy  String?
  createdAt  DateTime  @default(now())
  finishedAt DateTime?
}

/// Settings for the whole service rather than one shop, such as the announcement banner.
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// A photo of an item for the Online Shop. Resized in the browser before upload, so each is
/// small (about 100 KB) and kept in the database with the rest of the shop's books.
model ItemImage {
  id         String   @id @default(uuid())
  businessId String
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  mime       String
  data       Bytes
  sort       Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([itemId, sort])
}

/// An order a customer sent from the shop's Online Shop. NEW until the shop answers it;
/// COMPLETED once it is rung up as a sale in POS (saleId), or CANCELLED.
model OnlineOrder {
  id            String            @id @default(uuid())
  businessId    String
  orderNo       String
  status        String            @default("NEW")
  customerName  String
  customerPhone String
  address       String?
  note          String?
  total         BigInt
  saleId        String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  lines         OnlineOrderLine[]

  @@unique([businessId, orderNo])
  @@index([businessId, createdAt])
}

model OnlineOrderLine {
  id        String      @id @default(uuid())
  orderId   String
  order     OnlineOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId    String
  name      String
  quantity  Int
  unitPrice BigInt
}

/// The shop's order list (အမှာစာရင်း): a part to get — a screen, a battery — often for a
/// customer who left a deposit and kept their phone. TODO until it is sent to a supplier,
/// ORDERED (with that supplier) while it is awaited, RECEIVED once it is in, when it leaves the
/// list. A supplier without it sends it back to TODO for the next one; `note` keeps where it
/// was tried. Apart from repair jobs; the deposit is written down here, not paid into a wallet.
model PartOrder {
  id            String   @id @default(uuid())
  businessId    String
  item          String
  quantity      Int      @default(1)
  /// The unit price the supplier quoted, once their quotation is in; 0 until then.
  price         BigInt   @default(0)
  customerName  String?
  customerPhone String?
  deposit       BigInt   @default(0)
  note          String?
  status        String   @default("TODO") // TODO ORDERED RECEIVED
  /// The supplier it was last sent to, and when.
  supplier      String?
  orderedAt     DateTime?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([businessId, status, createdAt])
}

/// A note a shop sends from the About page. The admin portal reads them all and picks which
/// ones show on the About page for everyone.
model Feedback {
  id         String   @id @default(uuid())
  businessId String
  userId     String
  shopName   String
  userName   String
  /// 1 to 5 stars, or none.
  rating     Int?
  message    String
  shown      Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([shown, createdAt])
}

/// A slip a phone sent to the shop's counter printer (cloud print). The print station page,
/// open on the PC the printer hangs off, takes each one in turn and prints it there.
/// Only shops listed in CLOUD_PRINT_BUSINESS_IDS can send them; old rows are cleared after a day.
model PrintJob {
  id         String    @id @default(uuid())
  businessId String
  userId     String
  /// The slip's name in the station's list, such as the invoice or voucher number.
  title      String
  /// The whole slip as a page of its own, styles included.
  html       String
  /// QUEUED, PRINTING (a station took it), PRINTED or FAILED.
  status     String    @default("QUEUED")
  error      String?
  claimedAt  DateTime?
  printedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([businessId, status, createdAt])
  @@index([createdAt])
}

/// A money transfer or cash-out done for a customer through the shop's KBZPay / Wave
/// account (an agent service). TRANSFER: the customer hands over cash and the shop sends it
/// from the account. CASHOUT: the customer sends to the account and takes cash. The amount
/// moves between the two wallets; the fee is the shop's, an income entry of its own (Other income).
model MoneyService {
  id              String    @id @default(uuid())
  txnNo           String
  businessId      String
  branchId        String?
  /// TRANSFER or CASHOUT.
  kind            String
  /// The KBZPay / Wave wallet the money went out of or came into.
  accountWalletId String
  /// The drawer the customer's cash went into or came out of; the fee lands here too.
  cashWalletId    String
  amount          BigInt
  fee             BigInt    @default(0)
  /// The fee's income entry.
  feeIncomeId     String?
  customerName    String?
  customerPhone   String?
  note            String?
  createdById     String
  createdAt       DateTime  @default(now())
  voidedAt        DateTime?
  voidedById      String?
  voidReason      String?

  @@unique([businessId, txnNo])
  @@index([businessId, createdAt])
}

/// A member of staff the shop pays: not necessarily a login (a user can be linked to them).
model Staff {
  id          String    @id @default(uuid())
  businessId  String
  name        String
  phone       String?
  position    String?
  /// Monthly salary.
  salary      BigInt    @default(0)
  /// Added to a month's salary when no day was taken off (absent, half day or leave).
  attendanceBonus BigInt @default(0)
  /// Kept from each month's salary; paid back after six months.
  deposit     BigInt    @default(0)
  startDate   String?
  /// The login this person uses, if any: a Service Tech's repair commission comes from it.
  userId      String?
  note        String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([businessId, active])
}

/// One day of one member of staff: PRESENT, ABSENT, HALF (half a day off) or LEAVE (paid leave).
model StaffAttendance {
  id          String   @id @default(uuid())
  businessId  String
  staffId     String
  date        String
  status      String
  note        String?
  createdById String
  updatedAt   DateTime @updatedAt

  @@unique([staffId, date])
  @@index([businessId, date])
}

/// A bonus paid on its own (year end, Thingyan…): a Staff Salary expense. Or, held: a share of
/// a month's profit left after Boss Share, kept in the staff member's balance until withdrawn.
model StaffBonus {
  id          String    @id @default(uuid())
  businessId  String
  staffId     String
  amount      BigInt
  date        String
  walletId    String?
  expenseId   String?
  /// Kept in the held balance (from the profit left after Boss Share), not paid out now.
  held        Boolean   @default(false)
  /// The profit month a held bonus came from (YYYY-MM).
  month       String?
  note        String?
  createdById String
  createdAt   DateTime  @default(now())
  voidedAt    DateTime?

  @@index([businessId, staffId])
}

/// Money withdrawn from a staff member's held balance (deposit, no days off bonus, profit
/// bonus). The deposit and no days off bonus part is a Staff Salary expense; the profit bonus
/// part is a withdrawal, since that profit was already counted.
model StaffDepositReturn {
  id           String    @id @default(uuid())
  businessId   String
  staffId      String
  amount       BigInt
  /// Of the amount, what came from profit bonuses (the withdrawal); the rest is the expense.
  profitAmount BigInt    @default(0)
  date         String
  walletId     String
  expenseId    String?
  withdrawId   String?
  note         String?
  createdById String
  createdAt   DateTime  @default(now())
  voidedAt    DateTime?

  @@index([businessId, staffId])
}

/// Money given to staff before payday; taken off their next salary.
model StaffAdvance {
  id              String    @id @default(uuid())
  businessId      String
  staffId         String
  amount          BigInt
  date            String
  walletId        String
  /// Older advances only: the Staff Salary expense that took the money out. An advance now
  /// is money owed back by the staff member, not an expense; the salary it comes off is.
  expenseId       String?
  /// The salary payment it was taken off, once paid.
  salaryPaymentId String?
  note            String?
  createdById     String
  createdAt       DateTime  @default(now())
  voidedAt        DateTime?

  @@index([businessId, staffId])
}

/// A month's salary paid to one member of staff.
model StaffSalaryPayment {
  id               String    @id @default(uuid())
  businessId       String
  staffId          String
  /// YYYY-MM
  month            String
  baseSalary       BigInt
  absentDays       Decimal   @default(0) @db.Decimal(5, 1)
  absentDeduction  BigInt    @default(0)
  advanceDeduction BigInt    @default(0)
  commission       BigInt    @default(0)
  bonus            BigInt    @default(0)
  /// For a month with no day off.
  attendanceBonus  BigInt    @default(0)
  otherDeduction   BigInt    @default(0)
  /// Kept back as the staff member's deposit (owed to them, paid back later).
  deposit          BigInt    @default(0)
  /// The no days off bonus put into the held balance instead of paid (the whole of it).
  bonusHeld        BigInt    @default(0)
  net              BigInt
  walletId         String
  /// The Staff Salary expense; none when nothing was left to pay.
  expenseId        String?
  note             String?
  createdById      String
  createdAt        DateTime  @default(now())
  voidedAt         DateTime?

  @@index([businessId, month])
  @@index([staffId, month])
}

/// A month's Boss Share taken out of a wallet: each partner's share, as one withdrawal (not an
/// expense, so the profit stays as it was). One per month unless cancelled.
model BossShareTake {
  id          String    @id @default(uuid())
  businessId  String
  /// YYYY-MM
  month       String
  amount      BigInt
  /// [{ name, percent, amount }] as taken.
  shares      Json
  walletId    String
  withdrawId  String
  createdById String
  createdAt   DateTime  @default(now())
  voidedAt    DateTime?

  @@index([businessId, month])
}

/// Stock sent from one branch to another (STR-000001). Both sides move at once: out of the
/// sending branch, into the receiving one, at the item's cost then. Cancelling sends it back.
model StockTransfer {
  id            String    @id @default(uuid())
  businessId    String
  txnNo         String
  fromBranchId  String
  toBranchId    String
  date          String // YYYY-MM-DD
  notes         String?
  status        String    @default("COMPLETED") // COMPLETED CANCELLED
  createdById   String
  createdAt     DateTime  @default(now())
  cancelledAt   DateTime?
  cancelledById String?
  cancelReason  String?

  lines StockTransferLine[]

  @@unique([businessId, txnNo])
  @@index([businessId, date])
}

model StockTransferLine {
  id         String        @id @default(uuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id])
  itemId     String
  item       Item          @relation(fields: [itemId], references: [id])
  quantity   Int
  /// The item's cost price when sent (minor units), for the value moved.
  unitCost   BigInt        @default(0)
  /// IMEI-tracked phones: the units sent, comma-separated.
  imeis      String?

  @@index([transferId])
}
